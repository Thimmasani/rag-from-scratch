---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">Dinesh Reddy Thimmasani</a></h2>
		<div class="internal-links">
			<HeaderLink href="/blog">Writings</HeaderLink>
			<div class="dropdown">
				<button class="dropdown-toggle" aria-haspopup="true">Social</button>
				<div class="dropdown-menu">
					<a href="https://www.linkedin.com/in/dinesh-reddy-thimmasani-11640899/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
					<a href="mailto:thimmasanidineshreddy19@gmail.com">Email</a>
				</div>
			</div>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #fafafa;
	}
	h2 {
		margin: 0;
		font-size: 1.1em;
		font-weight: 700;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--black);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 820px;
		margin: 0 auto;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-size: 0.95em;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.dropdown {
		position: relative;
	}
	.dropdown-toggle {
		background: none;
		border: none;
		font: inherit;
		font-size: 0.95em;
		color: var(--black);
		padding: 1em 0.5em;
		cursor: pointer;
	}
	.dropdown-menu {
		display: none;
		position: absolute;
		right: 0;
		top: 100%;
		background: #fff;
		border-radius: 8px;
		box-shadow: var(--box-shadow);
		min-width: 140px;
		padding: 0.4em 0;
		z-index: 10;
	}
	.dropdown-menu a {
		display: block;
		padding: 0.6em 1em;
		font-size: 0.9em;
	}
	.dropdown:hover .dropdown-menu,
	.dropdown:focus-within .dropdown-menu {
		display: block;
	}
</style>
