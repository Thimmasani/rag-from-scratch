---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import profilePhoto from '../assets/profile.png';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="homepage">
		<Header />
		<main>
			<div class="card">
				<Image src={profilePhoto} alt="Dinesh Reddy Thimmasani" width={320} height={320} class="profile-photo" />
				<div class="bio">
					<h1>About Me</h1>
					<p>
						Hi there, I'm a Machine Learning Engineer / Data Scientist with close to 6 years of
						experience in recommendation systems, search, and applied GenAI. I'm currently <strong>Founding Data Scientist (AI/ML) at Shuru</strong>, building hyperlocal personalization
						and multilingual search for a 20M+ user base, along with multi-agent LLM systems and a
						computer vision pipeline for content safety.
					</p>
					<p>
						Before this, I worked on credit risk and fair-lending models at <strong>Scienaptic AI</strong>,
						scaled <strong>Zomato</strong>'s home page recommendation engine, and built recommendation and
						ranking systems as a Machine Learning Engineer at <strong>Hotstar</strong>. I studied
						Mathematics and Computing at <strong>IIT Guwahati</strong>.
					</p>
					<p>
						On this site, I write about ML and AI — concepts, systems, and projects built from
						scratch rather than through framework abstractions. Check out my <a href="/blog">writings</a> for the series.
					</p>
				</div>
			</div>

			<div class="section-label">Series</div>

			<section class="series-card">
				<div class="series-top">
					<h2 class="series-title">Retrieval-Augmented Generation (RAG)</h2>
					<span class="series-meta">10 parts &middot; from scratch, no framework abstractions</span>
				</div>
				<ul class="part-list">
					<li><a href="/blog/rag-from-scratch-01-tfidf-bm25/">1. Lexical retrieval — TF-IDF &amp; BM25</a></li>
					<li><a href="/blog/rag-from-scratch-02-embeddings/">2. Semantic retrieval — embeddings</a></li>
					<li><a href="/blog/rag-from-scratch-03-hybrid-rrf/">3. Hybrid retrieval — BM25 + RRF</a></li>
					<li><a href="/blog/rag-from-scratch-04-reranking/">4. Cross-encoder reranking (and where it fails too)</a></li>
					<li><a href="/blog/rag-from-scratch-05-generation/">5. The generation layer</a></li>
					<li><a href="/blog/rag-from-scratch-06-evaluation/">6. Evaluating the whole pipeline</a></li>
					<li><a href="/blog/rag-from-scratch-07-chunking/">7. Chunking</a></li>
					<li><a href="/blog/rag-from-scratch-08-vector-search-at-scale/">8. Vector search at scale (ANN + metadata filtering)</a></li>
					<li><a href="/blog/rag-from-scratch-09-multihop-retrieval/">9. Multi-hop retrieval</a></li>
					<li><a href="/blog/rag-from-scratch-10-long-context/">10. RAG vs. long-context LLMs</a></li>
				</ul>
				<a class="also-link" href="/blog/rag-interview-questions/">&rarr; RAG Interview Questions (28 Q&amp;A, same series' data)</a>
			</section>

			<section class="series-card placeholder">
				<div class="series-top">
					<h2 class="series-title">Fine-tuning &amp; LoRA</h2>
					<span class="coming-soon-tag">in progress</span>
				</div>
				<p class="series-desc">
					Hand-rolled LoRA adapters, QLoRA, comparing a from-scratch implementation against <code>peft</code>.
				</p>
			</section>

			<section class="series-card placeholder">
				<div class="series-top">
					<h2 class="series-title">AI Workflows &amp; Agents</h2>
					<span class="coming-soon-tag">planned</span>
				</div>
				<p class="series-desc">
					ReAct-style agent loops built from scratch, then rebuilt in LangGraph to compare what the
					framework actually abstracts.
				</p>
			</section>

			<section class="series-card placeholder">
				<div class="series-top">
					<h2 class="series-title">Evals &amp; Observability</h2>
					<span class="coming-soon-tag">planned</span>
				</div>
				<p class="series-desc">
					Retrieval and generation eval harnesses, LLM-as-judge design, latency/cost tracking,
					regression gates.
				</p>
			</section>

			<section class="series-card placeholder">
				<div class="series-top">
					<h2 class="series-title">Recommendations &amp; Search</h2>
					<span class="coming-soon-tag">planned</span>
				</div>
				<p class="series-desc">
					Learning-to-rank, CTR calibration, cold start, the retrieval&rarr;ranking&rarr;rerank funnel
					outside of RAG.
				</p>
			</section>

			<section class="series-card placeholder">
				<div class="series-top">
					<h2 class="series-title">Traditional ML</h2>
					<span class="coming-soon-tag">planned</span>
				</div>
				<p class="series-desc">
					The fundamentals series — bias/variance, regularization, evaluation metrics, feature
					engineering — from scratch.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	body.homepage {
		background: #f7f7f8;
		min-height: 100vh;
	}
	body.homepage main {
		max-width: 1200px;
		width: 75%;
		margin: 0 auto;
	}
	.card {
		display: flex;
		gap: 2.5em;
		align-items: flex-start;
		background: #fff;
		border-radius: 12px;
		padding: 2.5em;
		box-shadow: var(--box-shadow);
	}
	.profile-photo {
		width: 160px;
		height: 160px;
		object-fit: cover;
		border-radius: 12px;
		flex-shrink: 0;
	}
	.bio h1 {
		font-size: 1.3em;
		margin: 0 0 0.6em 0;
	}
	.bio p {
		margin: 0 0 1em 0;
		font-size: 0.95em;
		line-height: 1.7;
	}
	.bio p:last-child {
		margin-bottom: 0;
	}
	@media (max-width: 600px) {
		.card {
			flex-direction: column;
			align-items: center;
			text-align: center;
			padding: 1.8em;
		}
	}

	.section-label {
		font-size: 0.78em;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		font-weight: 700;
		margin: 2.5em 0 0.9em 0.6em;
	}

	.series-card {
		background: #fff;
		border-radius: 12px;
		padding: 1.8em 2em;
		margin-bottom: 1.1em;
		box-shadow:
			0 1px 3px rgba(var(--gray), 20%),
			0 1px 2px rgba(var(--gray), 15%);
		border: 1px solid rgb(var(--gray-light));
	}
	.series-card.placeholder {
		opacity: 0.6;
		border-style: dashed;
	}
	.series-top {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		flex-wrap: wrap;
	}
	.series-title {
		font-size: 1.15em;
		font-weight: 700;
		margin: 0;
	}
	.series-meta {
		font-size: 0.82em;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
	.series-desc {
		font-size: 0.92em;
		color: rgb(var(--gray-dark));
		margin: 0.5em 0 1em 0;
		max-width: 620px;
	}
	.placeholder .series-title {
		color: rgb(var(--gray-dark));
	}
	.placeholder .series-desc {
		font-style: italic;
		margin-bottom: 0;
	}
	.coming-soon-tag {
		font-size: 0.72em;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray));
		padding: 0.2em 0.6em;
		border-radius: 10px;
		font-weight: 700;
		letter-spacing: 0.03em;
	}

	.part-list {
		list-style: none;
		margin: 1em 0 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45em;
	}
	.part-list li {
		font-size: 0.88em;
		padding-left: 1.2em;
		position: relative;
	}
	.part-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
	}
	.part-list a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	.part-list a:hover {
		color: var(--accent);
	}
	.also-link {
		font-size: 0.85em;
		margin-top: 0.9em;
		display: block;
		color: rgb(var(--gray-dark));
	}

	@media (max-width: 600px) {
		.series-card {
			padding: 1.3em 1.4em;
		}
	}
</style>
